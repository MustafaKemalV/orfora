# Copy to .env and fill in. Used only by scripts/eval.ts, which runs locally.
# orfora itself never reads this: callers always pass their own key.
OPENAI_API_KEY=

# Optional: use any OpenAI-compatible provider instead of OpenAI directly.
# For OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_EMBED_MODEL=openai/text-embedding-3-small
